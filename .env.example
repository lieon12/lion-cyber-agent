# Salin ke .env dan isi kalau pakai API. Jangan commit file .env asli.
# Jangan kirim API key ke chat atau ke siapa pun.
# Buat key di Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Nama model bisa diganti kalau Google mengganti nama model.
# Contoh: gemini-3.8-flash (per 2026-11-11, gemini-2.0-flash sudah pensiun)
GEMINI_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=
# Daftar domain yang BOLEH di-scan, pisahkan koma.
# verifydeal.site = website sendiri. testphp.vulnweb.com dan
# demo.owasp-juice.shop = situs uji publik yang sengaja dibuat rentan.
# Validator menolak URL di luar daftar ini, apa pun kata modelnya.
ALLOWED_DOMAINS=verifydeal.site,example.com,testphp.vulnweb.com,demo.owasp-juice.shop
